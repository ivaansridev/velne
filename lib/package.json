{
    "name": "velne-lib",
    "version": "0.1.0",
    "license": "MIT",
    "repository": "github:ivaansridev/velne",
    "scripts": {
        "dev": "vite dev",
        "build": "vite build && bun run prepack",
        "preview": "vite preview",
        "prepare": "bunx --no-install svelte-kit sync || echo ''",
        "prepack": "bunx --no-install svelte-kit sync && bunx --no-install svelte-package && bunx --no-install publint",
        "check": "bunx --no-install svelte-kit sync && bunx --no-install svelte-check --tsconfig ./tsconfig.json",
        "check:watch": "bunx --no-install svelte-kit sync && bunx --no-install svelte-check --tsconfig ./tsconfig.json --watch"
    },
    "files": [
        "dist",
        "!dist/**/*.test.*",
        "!dist/**/*.spec.*"
    ],
    "sideEffects": [
        "**/*.css"
    ],
    "svelte": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "svelte": "./dist/index.js"
        },
        "./tokens.css": "./dist/tokens.css"
    },
    "peerDependencies": {
        "svelte": "^5.0.0"
    },
    "devDependencies": {
        "@sveltejs/adapter-auto": "^8.0.0",
        "@sveltejs/kit": "^3.0.0",
        "@sveltejs/package": "^2.5.8",
        "@sveltejs/vite-plugin-svelte": "^7.2.0",
        "publint": "^0.3.21",
        "svelte": "^5.57.1",
        "svelte-check": "^4.6.0",
        "typescript": "^6.0.3",
        "vite": "^8.3.0"
    },
    "keywords": [
        "svelte"
    ],
    "imports": {
        "#lib": "./src/lib/index.js",
        "#lib/*": "./src/lib/*"
    }
}
